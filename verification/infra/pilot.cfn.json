{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Peer Link isolated Nitro synthetic pilot. No ingress or application secrets; external expiry guard.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "ImageId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    }
  },
  "Resources": {
    "HostRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "peer-link"
          },
          {
            "Key": "Environment",
            "Value": "pilot"
          }
        ],
        "Policies": [
          {
            "PolicyName": "SessionManagerTransportOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:UpdateInstanceInformation",
                    "ssmmessages:CreateControlChannel",
                    "ssmmessages:CreateDataChannel",
                    "ssmmessages:OpenControlChannel",
                    "ssmmessages:OpenDataChannel",
                    "ec2messages:AcknowledgeMessage",
                    "ec2messages:DeleteMessage",
                    "ec2messages:FailMessage",
                    "ec2messages:GetEndpoint",
                    "ec2messages:GetMessages",
                    "ec2messages:SendReply"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "ssm:GetParameter*",
                    "secretsmanager:*",
                    "kms:*",
                    "sts:AssumeRole",
                    "iam:*",
                    "s3:*"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "NoResourcePolicyWideningInSharedAccount",
                  "Effect": "Deny",
                  "NotAction": [
                    "ssm:UpdateInstanceInformation",
                    "ssmmessages:CreateControlChannel",
                    "ssmmessages:CreateDataChannel",
                    "ssmmessages:OpenControlChannel",
                    "ssmmessages:OpenDataChannel",
                    "ec2messages:AcknowledgeMessage",
                    "ec2messages:DeleteMessage",
                    "ec2messages:FailMessage",
                    "ec2messages:GetEndpoint",
                    "ec2messages:GetMessages",
                    "ec2messages:SendReply"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "HostProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "HostRole"
          }
        ]
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Peer Link synthetic build: no ingress; outbound TLS only",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "peer-link"
          }
        ]
      }
    },
    "Host": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "ImageId"
        },
        "InstanceType": "c6i.xlarge",
        "IamInstanceProfile": {
          "Ref": "HostProfile"
        },
        "EnclaveOptions": {
          "Enabled": true
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1
        },
        "InstanceInitiatedShutdownBehavior": "terminate",
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 24,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "SubnetId"
            },
            "GroupSet": [
              {
                "Ref": "SecurityGroup"
              }
            ]
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "peer-link-verifier-pilot"
          },
          {
            "Key": "Project",
            "Value": "peer-link"
          },
          {
            "Key": "Environment",
            "Value": "pilot"
          },
          {
            "Key": "Owner",
            "Value": "peer-link"
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Join": [
              "\n",
              [
                "#!/bin/bash",
                "set -euo pipefail",
                "shutdown -h +110",
                "dnf install -y aws-nitro-enclaves-cli aws-nitro-enclaves-cli-devel docker python3.11 git",
                "systemctl enable --now docker",
                "printf '%s\\n' '---' 'memory_mib: 2048' 'cpu_count: 2' > /etc/nitro_enclaves/allocator.yaml",
                "systemctl enable --now nitro-enclaves-allocator.service",
                "install -d -m 700 /opt/peer-link"
              ]
            ]
          }
        }
      },
      "DependsOn": ["ExpirySchedule", "ExpiryPermission"]
    },
    "ExpiryRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ExpireOnlyThisStack",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ec2:DescribeInstances",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": "ec2:TerminateInstances",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "ec2:ResourceTag/aws:cloudformation:stack-id": {
                        "Ref": "AWS::StackId"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ExpiryFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "python3.12",
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": ["ExpiryRole", "Arn"]
        },
        "Timeout": 30,
        "MemorySize": 128,
        "Environment": {
          "Variables": {
            "STACK_ID": {
              "Ref": "AWS::StackId"
            }
          }
        },
        "Code": {
          "ZipFile": "import boto3, datetime, os\n\ndef handler(event, context):\n    ec2=boto3.client('ec2')\n    response=ec2.describe_instances(Filters=[{'Name':'tag:aws:cloudformation:stack-id','Values':[os.environ['STACK_ID']]},{'Name':'instance-state-name','Values':['pending','running','stopping','stopped']}])\n    now=datetime.datetime.now(datetime.timezone.utc)\n    expired=[i['InstanceId'] for r in response['Reservations'] for i in r['Instances'] if (now-i['LaunchTime']).total_seconds()>6600 or i['State']['Name'] in ('stopping','stopped')]\n    if expired: ec2.terminate_instances(InstanceIds=expired)\n    return {'terminated':len(expired)}\n"
        }
      }
    },
    "ExpirySchedule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "ScheduleExpression": "rate(5 minutes)",
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::GetAtt": ["ExpiryFunction", "Arn"]
            },
            "Id": "ExpirePilot",
            "RetryPolicy": {
              "MaximumRetryAttempts": 2,
              "MaximumEventAgeInSeconds": 300
            }
          }
        ]
      }
    },
    "ExpiryPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "ExpiryFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": ["ExpirySchedule", "Arn"]
        },
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        }
      }
    },
    "ExpiryErrors": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Peer Link expiry guard failing: inspect and terminate only this pilot stack.",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "ExpiryFunction"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Host"
      }
    },
    "RoleArn": {
      "Value": {
        "Fn::GetAtt": ["HostRole", "Arn"]
      }
    }
  }
}
